\ProvidesPackage{styles}

\usepackage[a4paper,margin=1.5cm]{geometry}
\usepackage[english]{babel}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{titlesec}

\raggedbottom
\raggedright
\hyphenpenalty=10000 \exhyphenpenalty=10000 % No hyphenated words: ATS keyword matching breaks on "Kuber-netes"

\titleformat{\section}{\scshape\Large\raggedright}{}{0pt}{}[\titlerule]
\titlespacing*{\section}{0pt}{12pt}{10pt}

% Contact info as plain text so ATS parsers can read it
% Usage: \header{Name}{Location}{Phone}{Email}{LinkedIn Handle}{GitHub Handle}{Website Domain}
\newcommand{\header}[7]{%
\begin{center}
    \textbf{\Huge \scshape #1} \\ \vspace{1pt}
    \small #2 $|$ #3 $|$ \href{mailto:#4}{#4} $|$ \href{https://#7}{#7} \\
    \href{https://linkedin.com/in/#5}{linkedin.com/in/#5} $|$
    \href{https://github.com/#6}{github.com/#6}
\end{center}
}

% Optional one line under the header, e.g. the target job title
\newcommand{\headline}[1]{\begin{center}\vspace{-6pt}\large #1\end{center}}

% Usage: \role{Position --- Company}{Location | Date}{projects}
\newcommand{\role}[3]{%
    \par\noindent
    {\large \textbf{#1}} \hfill \textit{#2}
    \begin{itemize}[leftmargin=0.25in, label={}]
        \item #3
    \end{itemize}
}

% Usage: \project{Name}{Tech Stack}{\item ...}
\newcommand{\project}[3]{%
    {\textit{#1} \hfill \textit{#2}}
    \begin{itemize}[leftmargin=0.3in, itemsep=2pt, parsep=0pt, label=\textbullet]
        #3
    \end{itemize}
}

% Usage: \skill{Category}{Comma-separated list of skills}
\newcommand{\skill}[2]{%
    \par\noindent
    \textbf{#1}: \textit{#2}%
    \par\vspace{2pt}
}

% Usage: \sideproject{Name}{Tech Stack}{\item ...}
\newcommand{\sideproject}[3]{%
    \noindent
    {\textbf{#1} \hfill \textit{#2}}%
    \begin{itemize}[leftmargin=0.3in, itemsep=2pt, parsep=0pt, topsep=0pt]
        #3
    \end{itemize}
}
