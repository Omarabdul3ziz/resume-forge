\ProvidesPackage{styles}

\usepackage[a4paper,margin=1.5cm]{geometry} % Set margins for all sides
\usepackage[english]{babel}
\usepackage{enumitem} % For list customization
\usepackage[hidelinks]{hyperref} % For links without colored boxes
\usepackage{titlesec} % For customizing section headers

\raggedbottom % Prevents stretching of vertical space on the page

% Section Header Formatting (Line separated, Large/Small Caps)
\titleformat{\section}{\scshape\Large\raggedright}{}{0pt}{}[\titlerule]
\titlespacing*{\section}{0pt}{12pt}{10pt}

% 1. Header: Contact Information
% Usage: \header{Name}{Phone}{Email}{LinkedIn Handle}{GitHub Handle}{Website Domain}
\newcommand{\header}[6]{%
\begin{center}
    \textbf{\Huge \scshape #1} \\ \vspace{1pt}
    \small #2 $|$
    \href{mailto:#3}{\underline{#3}} $|$
    \href{https://#6}{\underline{#6}} $|$
    \href{https://linkedin.com/in/#4}{\underline{LinkedIn}} $|$
    \href{https://github.com/#5}{\underline{GitHub}}
\end{center}
}

% 2. Experience Role Entry
% Usage: \role{Postion - Company}{Location and Date}{Block of Bullet Points/Projects}
\newcommand{\role}[3]{%
    \par\noindent % Start no paragraph un indented
    {\large \textbf{#1}} \hfill \textit{#2} % Title/Company left, Date/Location right
    \begin{itemize}[leftmargin=0.25in, label={}] % Empty label for no decoration, indenting the whole block
        \item #3 
    \end{itemize}
    % \vspace{4pt} % Use \vspace for a small break if needed, but \par should suffice
}

% 3. Project/Description Block
% Usage: \project{Name}{Tech Stack}{Item List (use \item)}
\newcommand{\project}[3]{%
    {\textbf{#1} \hfill \textit{#2}} % Project Name left, Tech Stack right
    \begin{itemize}[leftmargin=0.3in, itemsep=2pt, parsep=0pt, label=\textbullet]
        #3
    \end{itemize}
}

% 4. Skills Block
% Usage: \skill{Category}{Comma-separated list of skills}
\newcommand{\skill}[2]{%
    \par\noindent
    \textbf{#1}: \textit{#2}%
    \par\vspace{2pt} % adds vertical space after each skill
}

\newcommand{\sideproject}[3]{%
    \noindent
    {\textbf{#1} \hfill \textit{#2}}%
    \begin{itemize}[leftmargin=0.3in, itemsep=2pt, parsep=0pt, topsep=0pt]
        #3
    \end{itemize}
}
